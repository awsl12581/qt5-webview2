{
    "version": 6,
    "configurePresets": [
        {
            "name": "macos-appleclang-base",
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt@5"
            }
        },
        {
            "name": "macos-appleclang-debug",
            "displayName": "Apple Clang Debug (Ninja)",
            "inherits": "macos-appleclang-base",
            "binaryDir": "${sourceDir}/build/macos-appleclang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-appleclang-release",
            "displayName": "Apple Clang Release (Ninja)",
            "inherits": "macos-appleclang-base",
            "binaryDir": "${sourceDir}/build/macos-appleclang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-msvc-arm64-base",
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "type": "allOf",
                "conditions": [
                    {
                        "type": "equals",
                        "lhs": "${hostSystemName}",
                        "rhs": "Windows"
                    },
                    {
                        "type": "equals",
                        "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                        "rhs": "ARM64"
                    }
                ]
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "arm64-windows",
                "VCPKG_MANIFEST_MODE": "OFF"
            }
        },
        {
            "name": "windows-msvc-arm64-debug",
            "displayName": "MSVC ARM64 Debug (Ninja)",
            "inherits": "windows-msvc-arm64-base",
            "binaryDir": "${sourceDir}/build/windows-msvc-arm64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-msvc-arm64-release",
            "displayName": "MSVC ARM64 Release (Ninja)",
            "inherits": "windows-msvc-arm64-base",
            "binaryDir": "${sourceDir}/build/windows-msvc-arm64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-msvc-amd64-base",
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "type": "allOf",
                "conditions": [
                    {
                        "type": "equals",
                        "lhs": "${hostSystemName}",
                        "rhs": "Windows"
                    },
                    {
                        "type": "equals",
                        "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                        "rhs": "AMD64"
                    }
                ]
            },
            "toolset": {
                "value": "v143",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "OFF",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "windows-msvc-amd64-debug",
            "displayName": "MSVC AMD64 Debug (Ninja)",
            "inherits": "windows-msvc-amd64-base",
            "binaryDir": "${sourceDir}/build/windows-msvc-amd64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-msvc-amd64-release",
            "displayName": "MSVC AMD64 Release (Ninja)",
            "inherits": "windows-msvc-amd64-base",
            "binaryDir": "${sourceDir}/build/windows-msvc-amd64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos-appleclang-debug",
            "configurePreset": "macos-appleclang-debug"
        },
        {
            "name": "macos-appleclang-release",
            "configurePreset": "macos-appleclang-release"
        },
        {
            "name": "windows-msvc-arm64-debug",
            "configurePreset": "windows-msvc-arm64-debug",
            "condition": {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "ARM64"
            }
        },
        {
            "name": "windows-msvc-arm64-release",
            "configurePreset": "windows-msvc-arm64-release",
            "condition": {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "ARM64"
            }
        },
        {
            "name": "windows-msvc-amd64-debug",
            "configurePreset": "windows-msvc-amd64-debug",
            "condition": {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "AMD64"
            }
        },
        {
            "name": "windows-msvc-amd64-release",
            "configurePreset": "windows-msvc-amd64-release",
            "condition": {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "AMD64"
            }
        }
    ],
    "testPresets": [
        {
            "name": "macos-appleclang-debug",
            "configurePreset": "macos-appleclang-debug"
        },
        {
            "name": "windows-msvc-arm64-debug",
            "configurePreset": "windows-msvc-arm64-debug",
            "condition": {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "ARM64"
            }
        },
        {
            "name": "windows-msvc-amd64-debug",
            "configurePreset": "windows-msvc-amd64-debug",
            "condition": {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "AMD64"
            }
        }
    ]
}
