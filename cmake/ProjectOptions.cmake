set(SYSTEM_WEBVIEW_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
set(SYSTEM_WEBVIEW_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}")

option(SYSTEM_WEBVIEW_BUILD_SAMPLES "Build the System WebView samples." ON)
option(SYSTEM_WEBVIEW_BUILD_QT_HOST "Build the Qt 5 host adapter target." OFF)
option(SYSTEM_WEBVIEW_BUILD_GLFW_HOST "Build the GLFW 3 host adapter target." ON)
option(SYSTEM_WEBVIEW_BUILD_SDL3_HOST "Build the SDL 3 host adapter target." ON)
option(SYSTEM_WEBVIEW_BUILD_QT_SAMPLE "Build the Qt 5 sample." ${SYSTEM_WEBVIEW_BUILD_QT_HOST})
option(SYSTEM_WEBVIEW_BUILD_GLFW_SAMPLE "Build the GLFW 3 sample." ${SYSTEM_WEBVIEW_BUILD_GLFW_HOST})
option(SYSTEM_WEBVIEW_BUILD_SDL3_SAMPLE "Build the SDL 3 sample." ${SYSTEM_WEBVIEW_BUILD_SDL3_HOST})
option(SYSTEM_WEBVIEW_BUILD_WINDOWS_WIDGET_SAMPLE "Build the Windows Qt widget sample." OFF)

if(PROJECT_IS_TOP_LEVEL)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
endif()

if(PROJECT_IS_TOP_LEVEL AND CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
    set(CMAKE_INSTALL_PREFIX "${CMAKE_CURRENT_BINARY_DIR}/install" CACHE PATH
        "Install path prefix" FORCE)
endif()
